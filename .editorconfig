# https://editorconfig.org -- the indentation and encoding the code already
# uses, so any editor keeps it. Line endings are left to git (.gitattributes,
# core.autocrlf): the repository stores LF.
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
# backend/pyproject.toml: ruff's line-length
max_line_length = 110

[Makefile]
indent_style = tab

[*.sh]
end_of_line = lf

[*.md]
# two trailing spaces are a line break in Markdown
trim_trailing_whitespace = false
