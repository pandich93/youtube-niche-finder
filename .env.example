# Copy to .env (next to docker-compose.yml) and fill in.
# Get a key: https://console.cloud.google.com/apis/credentials
# and enable "YouTube Data API v3" in the same project.
YOUTUBE_API_KEY=

TZ=Asia/Tashkent

# --- Postgres --------------------------------------------------------------
# POSTGRES_HOST=postgres is the docker-compose service name; it resolves for
# any container on the `niche-finder_default` network (compose services, and
# scripts/mcp-docker.sh which joins that network explicitly). Running the
# server outside Docker instead? Set POSTGRES_HOST=localhost and use
# POSTGRES_HOST_PORT below (the port Postgres is published on, 127.0.0.1 only).
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=niches
POSTGRES_USER=niches
POSTGRES_PASSWORD=niches
POSTGRES_HOST_PORT=5433

# --- background worker ---------------------------------------------------
# Free novelty check for tracked channels via YouTube's RSS feed (no key,
# no quota) -- catches new uploads between the more expensive hot/daily
# refreshes below. Misses anything past the feed's ~15 most recent uploads.
WORKER_RSS_INTERVAL_MIN=30
# Alerts (8.9): compares fresh snapshots for TRACKED channels against
# thresholds and writes events (new outlier, acceleration, title change,
# came back after a silent stretch). Zero quota -- reads only what's already
# in the database, so this can safely run more often than the API-calling
# jobs below.
WORKER_ALERTS_INTERVAL_MIN=60
# Re-read view counts for videos published in the last WORKER_HOT_PERIOD.
# This is what makes vph24h / viewsGained24h / acceleration work at all.
WORKER_HOT_INTERVAL_MIN=180
WORKER_HOT_PERIOD=7d
WORKER_HOT_LIMIT=1000
# Backfill embeddings for videos collected without one (collect_channel,
# collect_trending and the RSS watch default to embed=False for speed).
# Zero YouTube quota -- pure local compute over title+description already
# in Postgres. WORKER_EMBED=0 turns the step off.
WORKER_EMBED_INTERVAL_MIN=60
WORKER_EMBED_BATCH=500
WORKER_EMBED=1

# Once a day: wider refresh + channel snapshots + trending charts.
WORKER_DAILY_INTERVAL_MIN=1440
WORKER_FULL_PERIOD=30d
WORKER_FULL_LIMIT=3000
WORKER_REGIONS=US
WORKER_TRENDING=1

# Topics to keep continuously fresh. One search call each per day out of the
# 100/day search budget, so up to ~90 topics is safe.
# WORKER_QUERIES=ai automation,faceless history,нейросети для бизнеса
WORKER_QUERY_PERIOD=24h
WORKER_QUERY_PAGES=1

# Bake the 220MB embedding model into the image at build time (0 = download on
# first use into the /models volume instead).
PREFETCH_MODEL=0

# Порт дашборда (http://localhost:<WEB_PORT>), слушает только localhost.
WEB_PORT=8080

# Port for the optional HTTP transport profile.
MCP_PORT=8765

# --- база при запуске backend'а ВНЕ Docker ------------------------------------
# Postgres из compose опубликован на 127.0.0.1:5433 (POSTGRES_HOST_PORT), а
# дефолт в коде -- localhost:5432, поэтому `uvicorn api:app` с хоста без этой
# строки падает с "Connection refused". Раскомментируйте, если запускаете
# backend/ или server.py локально, а не в контейнере.
# НЕ заменять это на POSTGRES_PORT=5433 -- compose отдаёт ту же переменную
# контейнерам как внутрисетевой порт и сломает web/worker/mcp (postgres:5433).
# NICHE_DATABASE_URL=postgresql://niches:niches@localhost:5433/niches

# --- лимит запросов к HTTP API -----------------------------------------------
# Сервис слушает только 127.0.0.1, поэтому это предохранитель от зациклившегося
# клиента, а не защита от чужого трафика. Расширение при быстрой прокрутке
# выдачи делает ~120-200 запросов в минуту, так что 600 -- с запасом.
# 0 выключает лимитер.
RATE_LIMIT_PER_MINUTE=600

# --- опциональный LLM (OpenRouter) -------------------------------------------
# Выключено по умолчанию -- ни одна функция не меняет поведение, пока это
# none. Включить: LLM_PROVIDER=openrouter + ключ ниже.
LLM_PROVIDER=none
# OPENROUTER_API_KEY=
# Не задано -- провайдер сам перебирает список бесплатных моделей
# (infrastructure/llm/openrouter.py:FREE_MODEL_FALLBACKS), пока одна не
# ответит. Задайте конкретную модель, если нужна именно она (бесплатная или
# платная) -- тогда перебора не будет.
# OPENROUTER_MODEL=
# OPENROUTER_REFERER=
# OPENROUTER_TITLE=
# Суточный бюджет в USD; при исчерпании llm_gateway.run() отдаёт None до
# полуночи UTC (аналог блокировки search-квоты по тихоокеанскому времени).
LLM_DAILY_BUDGET_USD=1.0
