# Copy to .env (next to docker-compose.yml) and fill in.
# Get a key: https://console.cloud.google.com/apis/credentials
# and enable "YouTube Data API v3" in the same project.
YOUTUBE_API_KEY=
# Shared daily quota pool, enforced before every call (the client refuses to
# go past it) and shown in the dashboard footer; raise it only if Google
# granted your project more than the default 10,000 units/day.
# YOUTUBE_DAILY_UNIT_LIMIT=10000
# Multi-user mode: units of that pool that signed-in users cannot spend, kept
# for the worker's stats snapshots and alerts. Tune it to the worker's real
# daily use (yt_units_<day> in meta on a day nobody signed in).
# WORKER_RESERVE_UNITS=1500

TZ=Asia/Tashkent

# --- Postgres --------------------------------------------------------------
# POSTGRES_HOST=postgres is the docker-compose service name; it resolves for
# any container on the `niche-finder_default` network (compose services, and
# scripts/mcp-docker.sh which joins that network explicitly). Running the
# server outside Docker instead? Set POSTGRES_HOST=localhost and use
# POSTGRES_HOST_PORT below (the port Postgres is published on, 127.0.0.1 only).
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=niches
POSTGRES_USER=niches
POSTGRES_PASSWORD=niches
POSTGRES_HOST_PORT=5433
# Row-Level Security (multi-user plan P1-02): user requests (dashboard, API,
# MCP tools) switch to this role, which sees only that user's personal rows.
# Created at start; default <POSTGRES_USER>_app. NF_DB_RLS=0 turns it off.
# See docs/hosting.md, "Row-Level Security".
# NF_DB_APP_ROLE=niches_app
# NF_DB_RLS=1

# --- background worker ---------------------------------------------------
# Free novelty check for tracked channels via YouTube's RSS feed (no key,
# no quota) -- catches new uploads between the more expensive hot/daily
# refreshes below. Misses anything past the feed's ~15 most recent uploads.
WORKER_RSS_INTERVAL_MIN=30
# Alerts (8.9): compares fresh snapshots for TRACKED channels against
# thresholds and writes events (new outlier, acceleration, title change,
# came back after a silent stretch). Zero quota -- reads only what's already
# in the database, so this can safely run more often than the API-calling
# jobs below.
WORKER_ALERTS_INTERVAL_MIN=60
# Re-read view counts for videos published in the last WORKER_HOT_PERIOD.
# This is what makes vph24h / viewsGained24h / acceleration work at all.
WORKER_HOT_INTERVAL_MIN=180
WORKER_HOT_PERIOD=7d
WORKER_HOT_LIMIT=1000
# Backfill embeddings for videos collected without one (collect_channel,
# collect_trending and the RSS watch default to embed=False for speed).
# Zero YouTube quota -- pure local compute over title+description already
# in Postgres. WORKER_EMBED=0 turns the step off.
WORKER_EMBED_INTERVAL_MIN=60
WORKER_EMBED_BATCH=500
WORKER_EMBED=1

# Once a day: wider refresh + channel snapshots + trending charts.
WORKER_DAILY_INTERVAL_MIN=1440
WORKER_FULL_PERIOD=30d
WORKER_FULL_LIMIT=3000
WORKER_REGIONS=US
WORKER_TRENDING=1

# Topics to keep continuously fresh. One search call each per day out of the
# 100/day search budget, so up to ~90 topics is safe.
# WORKER_QUERIES=ai automation,faceless history,нейросети для бизнеса
WORKER_QUERY_PERIOD=24h
WORKER_QUERY_PAGES=1

# Bake the 220MB embedding model into the image at build time (0 = download on
# first use into the /models volume instead).
PREFETCH_MODEL=0

# Порт дашборда (http://localhost:<WEB_PORT>), слушает только localhost.
WEB_PORT=8080

# Port for the optional HTTP transport profile.
MCP_PORT=8765
# Transport for server.py: stdio (Claude Desktop) or streamable-http; the
# mcp-http compose service sets these itself. Over HTTP without
# NF_MULTI_USER=1 there is no sign-in, so server.py listens only on loopback
# unless MCP_ALLOW_UNAUTHENTICATED=1 (set it only if no one else can reach
# MCP_HOST).
# MCP_TRANSPORT=stdio
# MCP_HOST=127.0.0.1
# MCP_ALLOW_UNAUTHENTICATED=0

# --- база при запуске backend'а ВНЕ Docker ------------------------------------
# Postgres из compose опубликован на 127.0.0.1:5433 (POSTGRES_HOST_PORT), а
# дефолт в коде -- localhost:5432, поэтому `uvicorn api:app` с хоста без этой
# строки падает с "Connection refused". Раскомментируйте, если запускаете
# backend/ или server.py локально, а не в контейнере.
# НЕ заменять это на POSTGRES_PORT=5433 -- compose отдаёт ту же переменную
# контейнерам как внутрисетевой порт и сломает web/worker/mcp (postgres:5433).
# NICHE_DATABASE_URL=postgresql://niches:niches@localhost:5433/niches
# Postgres schema to use (tests set their own nichetest_<random> one).
# NICHE_DB_SCHEMA=public

# --- лимит запросов к HTTP API -----------------------------------------------
# Сервис слушает только 127.0.0.1, поэтому это предохранитель от зациклившегося
# клиента, а не защита от чужого трафика. Расширение при быстрой прокрутке
# выдачи делает ~120-200 запросов в минуту, так что 600 -- с запасом.
# 0 выключает лимитер.
RATE_LIMIT_PER_MINUTE=600
# За reverse proxy (Caddy, nginx): его адрес или подсеть, через пробел или
# запятую. Только от этих адресов берётся настоящий IP клиента из
# X-Forwarded-For -- для лимитера и ограничения входа. Пусто = заголовку не
# верим (как раньше). '*' не принимается.
# NF_TRUSTED_PROXIES=172.16.0.0/12
# Многопользовательский режим, вход: неудач на один email до задержки
# (1, 2, 4 ... 15 мин), неудач с одного адреса до закрытия входа, окно в минутах.
# NF_LOGIN_MAX_FAILS=5
# NF_LOGIN_MAX_IP_FAILS=30
# NF_LOGIN_WINDOW_MIN=15

# --- защита HTTP API от чужих сайтов -----------------------------------------
# API отвечает только на Host 127.0.0.1, localhost, [::1] и имя сервиса web
# (с любым портом), остальное -- 400: так закрыт DNS rebinding. Если открываете
# дашборд или настраиваете расширение по другому имени (hosts, .local), впишите
# его сюда через запятую, без схемы; порт можно не указывать.
# Изменяющие запросы (POST/PUT/PATCH/DELETE) без Content-Type: application/json
# и без заголовка X-NF-Client получают 403 -- скриптам нужен
#   curl -H 'X-NF-Client: script' ...
# NF_ALLOWED_HOSTS=
# Каким расширениям Chrome API отвечает по CORS: ID своих расширений через
# запятую (32 буквы a-p; видно на chrome://extensions или в адресе страницы в
# Web Store). Без значения локальный режим пускает любое chrome-extension://,
# как раньше (у распакованного расширения ID на каждой машине свой, а сервис
# слушает только 127.0.0.1), а сервер с входом (NF_MULTI_USER=1) -- ни одного.
# Своему расширению с выданным доступом к домену CORS не нужен; список нужен,
# чтобы ни одно чужое расширение не читало API из браузера пользователя.
# NF_EXTENSION_IDS=

# --- опциональный LLM (OpenRouter или локальный Ollama) ----------------------
# Выключено по умолчанию -- ни одна функция не меняет поведение, пока это
# none. Включить: LLM_PROVIDER=openrouter + ключ ниже, либо LLM_PROVIDER=ollama
# (этап 11) -- тогда вообще ничего не уходит с машины, см. PRIVACY.md.
LLM_PROVIDER=none
# OPENROUTER_API_KEY=
# Не задано -- провайдер сам перебирает список бесплатных моделей
# (infrastructure/llm/openrouter.py:FREE_MODEL_FALLBACKS), пока одна не
# ответит. Задайте конкретную модель, если нужна именно она (бесплатная или
# платная) -- тогда перебора не будет.
# OPENROUTER_MODEL=
# Long-context model for comment_insights (hundreds of comments can exceed
# some free models' context); unset = same as OPENROUTER_MODEL.
# OPENROUTER_MODEL_LONG=
# OPENROUTER_REFERER=
# OPENROUTER_TITLE=
# Суточный бюджет в USD; при исчерпании llm_gateway.run() отдаёт None до
# полуночи UTC (аналог блокировки search-квоты по тихоокеанскому времени).
LLM_DAILY_BUDGET_USD=1.0
# Part of that budget only the worker (and single-user mode) may spend, so
# background enrichment goes on when signed-in users have spent the rest.
LLM_WORKER_RESERVE_USD=0.25
# Price of a model OpenRouter's price list does not name (USD per million
# tokens, prompt and answer alike) -- high on purpose.
LLM_FALLBACK_USD_PER_MTOK=15

# LLM_PROVIDER=ollama -- нужен установленный и запущенный Ollama
# (https://ollama.com) со стянутой моделью (`ollama pull <модель>`), либо
# `docker compose --profile llm-local up -d ollama` (см. docker-compose.yml).
# Дефолт для OLLAMA_URL: host.docker.internal:11434 внутри контейнера,
# 127.0.0.1:11434 вне Docker -- задайте свой, если Ollama-сервис из compose
# (OLLAMA_URL=http://ollama:11434) или другой хост/порт.
# OLLAMA_URL=
# У Ollama нет каталога бесплатных моделей для перебора -- OLLAMA_MODEL
# обязателен, иначе complete_json() сразу возвращает None.
# OLLAMA_MODEL=llama3.1

# --- фоновая AI-разметка каналов и видео (этап 03) ---------------------------
# Работает только если LLM_PROVIDER != none (см. выше) -- иначе шаг "enrich"
# в воркере просто пропускается, без обращений к БД сверх обычного.
WORKER_ENRICH_INTERVAL_MIN=120
WORKER_ENRICH_CHANNEL_BATCH=50
WORKER_ENRICH_VIDEO_BATCH=100
# Канал переразмечается, если метка старше стольки дней (или её вообще нет).
LLM_RELABEL_DAYS=30
# Ниша начинает авто-теговаться LLM только когда в конкретной tag_group уже
# накопилось столько ручных/claude-mcp тегов -- иначе таксономия не устоялась.
LLM_MIN_MANUAL_TAGS=20
# Cache lifetime for comment_insights and explain_outlier (why-viral) results;
# a repeat call inside the window costs neither quota nor LLM budget.
LLM_INSIGHTS_TTL_DAYS=7
LLM_WHY_VIRAL_TTL_DAYS=14
# Cache lifetime for the optional LLM read of a video's hook (hook_report with
# llm=true); keyed by a hash of the intro text, so an edited transcript is re-read.
LLM_HOOK_TTL_DAYS=30

# --- niche clusters (stage 08) ----------------------------------------------
# k-means over channel embeddings, recomputed by the worker on this interval.
# Needs at least NICHE_CLUSTERS_MIN_CHANNELS channels with embedded videos;
# channels above NICHE_CLUSTERS_COMPETITION_SUBS count as competition.
WORKER_CLUSTER_INTERVAL_MIN=1440
NICHE_CLUSTERS_MIN_CHANNELS=10
NICHE_CLUSTERS_COMPETITION_SUBS=100000

# --- thumbnail fingerprints / "Перепаковки" (plan 05) ------------------------
# The API's thumbnail URL never changes when a creator uploads a new image, so
# the worker downloads the current thumbnail (i.ytimg.com, 320x180, no API
# quota) of tracked channels' videos from the last WORKER_FULL_PERIOD, and
# keeps each distinct version to show "before/after". WORKER_THUMBS=0 turns
# the step off (no requests to i.ytimg.com at all).
WORKER_THUMBS=1
WORKER_THUMBS_INTERVAL_MIN=360
WORKER_THUMBS_LIMIT=500

# Sponsor map: the worker reads video descriptions already in the database and
# records "sponsored by X / promo code / affiliate link" signals per video. It
# only touches the local database (no requests, no API quota) and only videos
# that are new, edited or covered by newer rules. WORKER_SPONSORS=0 turns it off.
WORKER_SPONSORS=1
WORKER_SPONSORS_INTERVAL_MIN=60
WORKER_SPONSORS_LIMIT=5000

# Similar thumbnails (plan 13): turns each thumbnail into a CLIP vector so the
# dashboard and Claude can find visually similar thumbnails and a niche's
# thumbnail styles. OFF by default: the image model is ~0.34 GB on disk (the
# text model for "find thumbnails by description" another ~0.25 GB, loaded on
# first use), it uses CPU, and it downloads thumbnails from i.ytimg.com (not
# the Data API, no quota). Only the vector is kept, never the image.
WORKER_THUMB_EMBED=0
WORKER_THUMB_EMBED_INTERVAL_MIN=60
WORKER_THUMB_EMBED_LIMIT=200

# Your own channels (plan 14): real YouTube Analytics numbers of channels you
# connect through Google OAuth on the dashboard's "Мои каналы" screen. Off until
# all three are set -- setup steps in backend/README.md "Your own channels".
# OWN_OAUTH_CLIENT_ID / _SECRET: your own OAuth client of type "Desktop app".
# OWN_TOKENS_KEY: encrypts the stored refresh token; generate with
#   docker compose run --rm web python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# OWN_TOKENS_KEY_OLD: earlier keys, comma-separated, only for reading (key
# rotation, P1-12). To rotate: move the current key here, put a new one into
# OWN_TOKENS_KEY, restart, run `python cli.py rotate-secrets --apply`, then
# empty this line. Leave it empty if you never rotated.
# Plan 25 -- running it as a service: OWN_OAUTH_MODE=web uses ONE OAuth client of
# the service (type "Web application") that customers connect through without
# Google Cloud; OWN_OAUTH_REDIRECT_URI must then be
# https://<your domain>/api/own/oauth/callback (registered on the client), and
# revenue access is asked for separately. NF_SERVICE_NAME / NF_OPERATOR_NAME /
# NF_CONTACT_EMAIL fill the public /privacy and /terms pages Google's app
# verification asks for. See backend/README.md "Running it as a service".
# OWN_OAUTH_MODE=web
# NF_SERVICE_NAME=
# NF_OPERATOR_NAME=
# NF_CONTACT_EMAIL=
OWN_OAUTH_CLIENT_ID=
OWN_OAUTH_CLIENT_SECRET=
OWN_TOKENS_KEY=
OWN_TOKENS_KEY_OLD=
# Only if the dashboard is not on 127.0.0.1:8080:
# OWN_OAUTH_REDIRECT_URI=http://127.0.0.1:8080/api/own/oauth/callback
WORKER_OWN_SYNC=1
WORKER_OWN_SYNC_INTERVAL_MIN=1440

# --- Keeping stored data fresh (plan 16) ---
# YouTube's API policies allow keeping data fetched with a key at most 30 days
# before it is refreshed or deleted. Once a day the worker re-reads stored
# videos and channels not refreshed for REFRESH_STALE_DAYS (titles,
# descriptions, counters), oldest first, ~1 unit per 50 rows. Nothing is ever
# deleted. Set WORKER_FRESHNESS=0 to switch it off.
# Topics with "На YouTube" ticked are searched once a day (1 search call each,
# at most 5 a day); the step runs every 6 h to pick them up as they fall due.
WORKER_TOPIC_SEARCH=1
WORKER_TOPIC_SEARCH_INTERVAL_MIN=360
WORKER_FRESHNESS=1
WORKER_FRESHNESS_INTERVAL_MIN=1440
REFRESH_STALE_DAYS=25
REFRESH_STALE_MAX_VIDEOS=2500
REFRESH_STALE_MAX_CHANNELS=2500

# Maturity curve (share of 30-day views a video has at age N days), used by
# every age-adjusted score and projected30dViews. The worker re-fits it from
# your own snapshots on this interval and switches over only once 30+ videos
# have been watched from publication to 28+ days. MATURITY_CURVE_AUTO=0 keeps
# the shipped curve.
WORKER_CALIBRATE_INTERVAL_MIN=1440
MATURITY_CURVE_AUTO=1

# --- доставка алертов в Telegram / webhook (этап 07) -------------------------
# Выключено по умолчанию -- воркер только пишет события в events, никуда их
# не шлёт, пока не задан хотя бы один канал ниже. Telegram имеет приоритет
# над webhook, если заданы оба. НЕ коммитьте настоящий токен бота в git.
# NOTIFY_TELEGRAM_BOT_TOKEN=
# NOTIFY_TELEGRAM_CHAT_ID=
# NOTIFY_WEBHOOK_URL=
# Проверить: python cli.py notify-test (или docker compose exec web python cli.py notify-test)
NOTIFY_MAX_PER_CYCLE=10
# Отправляются только события за последние N дней: включивший уведомления
# получает новости, а не всю историю, и воркер не читает её целиком.
# NOTIFY_WINDOW_DAYS=7
# instant -- каждое событие отдельным сообщением (как раньше);
# digest  -- одно утреннее сообщение-сводка за сутки вместо отдельных алертов;
# both    -- и то и другое.
NOTIFY_MODE=instant
# Час отправки дайджеста по МЕСТНОМУ времени получателя, раньше не уйдёт: по
# часовому поясу из профиля (P2-03), иначе по NF_DEFAULT_TIMEZONE, иначе по
# времени контейнера (TZ выше). Раз в местные сутки, перевод часов не даёт
# ни второй, ни пропущенной отправки.
DIGEST_HOUR=8
# Часовой пояс IANA (например Europe/Moscow) для тех, кто не выбрал свой в
# профиле: час дайджеста и время в напоминаниях календаря. Пусто -- время
# контейнера (TZ) для дайджеста и UTC в напоминаниях, как раньше. Суточные
# квоты от него не зависят: единицы и поиски YouTube считаются по суткам
# Тихоокеанского времени, расходы LLM -- по UTC.
# NF_DEFAULT_TIMEZONE=
# 1 -- если за сутки ничего не случилось, дайджест не отправляется.
DIGEST_SKIP_EMPTY=1
# Как часто воркер проверяет, не пора ли отправить дайджест (минуты).
WORKER_DIGEST_CHECK_INTERVAL_MIN=10
# Проверить сразу: python cli.py digest-send (или POST /api/digest/send)
# Ссылка "дашборд" в сообщениях -- поменяйте, если дашборд не на localhost.
NOTIFY_DASHBOARD_URL=http://127.0.0.1:8080

# Multi-user mode (plan 15) -- EXPERIMENTAL, off by default. 1 = sign-in with
# accounts an admin creates (python cli.py create-user EMAIL --admin) or, with
# mail set up below, people create themselves (NF_REGISTRATION); without a
# session /api answers 401. Your existing data belongs to the user "local":
# give it a password with `python cli.py set-password local` to sign in as it.
# Each signed-in user's share of the day's LLM spend, inside
# LLM_DAILY_BUDGET_USD (0 = no personal limit).
NF_USER_DAILY_LLM_USD=0.25
NF_MULTI_USER=0
# Daily limits of the base tariff Free and the fallback when no usable base
# tariff exists (multi-user mode). An admin can set other values per tariff on
# the dashboard's "Админка" screen; 0 here means no limit.
NF_USER_DAILY_UNITS=2000
NF_USER_DAILY_SEARCH_CALLS=20
# How many channels a user of the base tariff may track (the worker refreshes
# each from the shared pool) and connect as their own; 0 = no limit.
NF_USER_MAX_TRACKED_CHANNELS=200
NF_USER_MAX_OWN_CHANNELS=5
# Multi-user plan P2-11: how many times an hour a regular user of the base
# tariff may start "refresh stats" and "check alerts" by hand -- each over their
# own watchlist, on their own quota (docs/manual-runs.md). 0 = only admins, as
# before; this is NOT "no limit" here. Admins are never limited.
NF_USER_MANUAL_RUNS_PER_HOUR=0
# MCP over HTTP with NF_MULTI_USER=1 requires a personal API token; this is the
# address clients reach it at (advertised in the auth metadata).
# MCP_PUBLIC_URL=https://localhost:8765
# 1 = the session cookie is only sent over HTTPS (set it behind a TLS proxy).
NF_COOKIE_SECURE=0
# Session lifetime (multi-user plan P1-04): a sign-in ends this many days after
# the last activity, and this many days after the sign-in at the latest.
# Activity extends it at most once per NF_SESSION_TOUCH_MINUTES.
NF_SESSION_IDLE_DAYS=14
NF_SESSION_MAX_DAYS=90
NF_SESSION_TOUCH_MINUTES=15
# Two-factor sign-in (multi-user plan P2-04; needs OWN_TOKENS_KEY). required =
# an admin without 2FA sees only its setup until they turn it on. Empty or
# optional (the default): everyone may turn it on in the profile, nobody must.
# NF_ADMIN_2FA=optional
# The name authenticator apps show for this server.
# NF_TOTP_ISSUER=niche-finder

# Mail for sign-up, password reset and email change (multi-user plan P1-06).
# Without SMTP_HOST and SMTP_FROM none of these exist: accounts are only
# created by an admin, and a forgotten password is reset with cli.py.
# SMTP_SECURITY: starttls (port 587 by default), ssl (465) or none (25).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=niche-finder <no-reply@niches.example.com>
# open = anyone can sign up with an email they can read (a one-time link
# confirms it); closed = only admins create accounts, reset still works.
NF_REGISTRATION=open
# Where the links in those emails point. Empty = https://NF_DOMAIN, else the
# address the request came to.
# NF_PUBLIC_URL=https://niches.example.com
# Emails a client address may trigger per hour, and emails one recipient may
# get per hour; over that the answer is 429 or, for the recipient, silence.
NF_MAIL_PER_IP_HOUR=10
NF_MAIL_PER_EMAIL_HOUR=3

# The action log (multi-user plan P1-07): sign-ins, failed sign-ins, password
# and email changes, API tokens, tariffs and admin actions, readable by admins
# on the "Админка" screen. Days an entry is kept (the worker removes older ones
# once a day); 0 = forever. Entries outlive a deleted account.
NF_AUDIT_RETENTION_DAYS=180

# Support view (multi-user plan P2-05): an admin on the "Админка" screen may
# look at an account read-only, with a reason that goes into the action log.
# Minutes one view lasts (1..240); after that the session is the admin's again.
NF_IMPERSONATION_MINUTES=30

# Interface language when nothing else says (ru or en): API answers without an
# X-NF-Locale / Accept-Language header, MCP scenarios and alerts of users who
# never picked a language, scenario titles and the CLI. The dashboard still
# follows each person's choice and browser. A hosted install for an
# English-speaking audience should set en.
NF_DEFAULT_LOCALE=ru

# --- hosting for other people (docker-compose.prod.yml, docs/hosting.md) ------
# Only read by `make prod-up`; a copy on your own machine ignores all of this.
# The public name of the server. Caddy gets a Let's Encrypt certificate for it,
# the API answers to it and MCP clients connect to https://NF_DOMAIN/mcp.
# DNS must point it at the server, ports 80 and 443 must be open. prod-up also
# needs a strong POSTGRES_PASSWORD above (set it before the first start: the
# database keeps the password it was created with).
# NF_DOMAIN=niches.example.com
# Backups: pg_dump every N hours into BACKUP_DIR on the host, each one checked
# by a trial restore; only the newest BACKUP_KEEP stay. Copy them off the
# server too -- a backup on the same disk dies with it.
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=14
# BACKUP_DIR=./backups
# BACKUP_VERIFY=1

# --- observability (multi-user plan P1-14) ---------------------------------
# json = one JSON object per log line on stderr, secrets masked, no emails or
# IP addresses (docker-compose.prod.yml sets it); text (default) = as before.
# NF_LOG_FORMAT=text
# A long random string opens GET /metrics (Prometheus text format) on the
# dashboard for `Authorization: Bearer <it>`; unset = /metrics answers 404.
# NF_METRICS_TOKEN=
# Operator alerts -- the shared YouTube pool is spent, a worker step failed --
# go to the NOTIFY_TELEGRAM_* / NOTIFY_WEBHOOK_URL above, at most once per
# kind every NF_OPERATOR_ALERT_HOURS. 0 turns them off.
# NF_OPERATOR_ALERTS=1
# NF_OPERATOR_ALERT_HOURS=6
