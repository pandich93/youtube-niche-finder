# Copy to .env (next to docker-compose.yml) and fill in.
# Get a key: https://console.cloud.google.com/apis/credentials
# and enable "YouTube Data API v3" in the same project.
YOUTUBE_API_KEY=
# Shared daily quota pool shown in the dashboard footer; raise it only if
# Google granted your project more than the default 10,000 units/day.
# YOUTUBE_DAILY_UNIT_LIMIT=10000

TZ=Asia/Tashkent

# --- Postgres --------------------------------------------------------------
# POSTGRES_HOST=postgres is the docker-compose service name; it resolves for
# any container on the `niche-finder_default` network (compose services, and
# scripts/mcp-docker.sh which joins that network explicitly). Running the
# server outside Docker instead? Set POSTGRES_HOST=localhost and use
# POSTGRES_HOST_PORT below (the port Postgres is published on, 127.0.0.1 only).
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=niches
POSTGRES_USER=niches
POSTGRES_PASSWORD=niches
POSTGRES_HOST_PORT=5433

# --- background worker ---------------------------------------------------
# Free novelty check for tracked channels via YouTube's RSS feed (no key,
# no quota) -- catches new uploads between the more expensive hot/daily
# refreshes below. Misses anything past the feed's ~15 most recent uploads.
WORKER_RSS_INTERVAL_MIN=30
# Alerts (8.9): compares fresh snapshots for TRACKED channels against
# thresholds and writes events (new outlier, acceleration, title change,
# came back after a silent stretch). Zero quota -- reads only what's already
# in the database, so this can safely run more often than the API-calling
# jobs below.
WORKER_ALERTS_INTERVAL_MIN=60
# Re-read view counts for videos published in the last WORKER_HOT_PERIOD.
# This is what makes vph24h / viewsGained24h / acceleration work at all.
WORKER_HOT_INTERVAL_MIN=180
WORKER_HOT_PERIOD=7d
WORKER_HOT_LIMIT=1000
# Backfill embeddings for videos collected without one (collect_channel,
# collect_trending and the RSS watch default to embed=False for speed).
# Zero YouTube quota -- pure local compute over title+description already
# in Postgres. WORKER_EMBED=0 turns the step off.
WORKER_EMBED_INTERVAL_MIN=60
WORKER_EMBED_BATCH=500
WORKER_EMBED=1

# Once a day: wider refresh + channel snapshots + trending charts.
WORKER_DAILY_INTERVAL_MIN=1440
WORKER_FULL_PERIOD=30d
WORKER_FULL_LIMIT=3000
WORKER_REGIONS=US
WORKER_TRENDING=1

# Topics to keep continuously fresh. One search call each per day out of the
# 100/day search budget, so up to ~90 topics is safe.
# WORKER_QUERIES=ai automation,faceless history,нейросети для бизнеса
WORKER_QUERY_PERIOD=24h
WORKER_QUERY_PAGES=1

# Bake the 220MB embedding model into the image at build time (0 = download on
# first use into the /models volume instead).
PREFETCH_MODEL=0

# Порт дашборда (http://localhost:<WEB_PORT>), слушает только localhost.
WEB_PORT=8080

# Port for the optional HTTP transport profile.
MCP_PORT=8765
# Transport for server.py: stdio (Claude Desktop) or streamable-http; the
# mcp-http compose service sets these itself.
# MCP_TRANSPORT=stdio
# MCP_HOST=0.0.0.0

# --- база при запуске backend'а ВНЕ Docker ------------------------------------
# Postgres из compose опубликован на 127.0.0.1:5433 (POSTGRES_HOST_PORT), а
# дефолт в коде -- localhost:5432, поэтому `uvicorn api:app` с хоста без этой
# строки падает с "Connection refused". Раскомментируйте, если запускаете
# backend/ или server.py локально, а не в контейнере.
# НЕ заменять это на POSTGRES_PORT=5433 -- compose отдаёт ту же переменную
# контейнерам как внутрисетевой порт и сломает web/worker/mcp (postgres:5433).
# NICHE_DATABASE_URL=postgresql://niches:niches@localhost:5433/niches
# Postgres schema to use (tests set their own nichetest_<random> one).
# NICHE_DB_SCHEMA=public

# --- лимит запросов к HTTP API -----------------------------------------------
# Сервис слушает только 127.0.0.1, поэтому это предохранитель от зациклившегося
# клиента, а не защита от чужого трафика. Расширение при быстрой прокрутке
# выдачи делает ~120-200 запросов в минуту, так что 600 -- с запасом.
# 0 выключает лимитер.
RATE_LIMIT_PER_MINUTE=600

# --- опциональный LLM (OpenRouter или локальный Ollama) ----------------------
# Выключено по умолчанию -- ни одна функция не меняет поведение, пока это
# none. Включить: LLM_PROVIDER=openrouter + ключ ниже, либо LLM_PROVIDER=ollama
# (этап 11) -- тогда вообще ничего не уходит с машины, см. PRIVACY.md.
LLM_PROVIDER=none
# OPENROUTER_API_KEY=
# Не задано -- провайдер сам перебирает список бесплатных моделей
# (infrastructure/llm/openrouter.py:FREE_MODEL_FALLBACKS), пока одна не
# ответит. Задайте конкретную модель, если нужна именно она (бесплатная или
# платная) -- тогда перебора не будет.
# OPENROUTER_MODEL=
# Long-context model for comment_insights (hundreds of comments can exceed
# some free models' context); unset = same as OPENROUTER_MODEL.
# OPENROUTER_MODEL_LONG=
# OPENROUTER_REFERER=
# OPENROUTER_TITLE=
# Суточный бюджет в USD; при исчерпании llm_gateway.run() отдаёт None до
# полуночи UTC (аналог блокировки search-квоты по тихоокеанскому времени).
LLM_DAILY_BUDGET_USD=1.0

# LLM_PROVIDER=ollama -- нужен установленный и запущенный Ollama
# (https://ollama.com) со стянутой моделью (`ollama pull <модель>`), либо
# `docker compose --profile llm-local up -d ollama` (см. docker-compose.yml).
# Дефолт для OLLAMA_URL: host.docker.internal:11434 внутри контейнера,
# 127.0.0.1:11434 вне Docker -- задайте свой, если Ollama-сервис из compose
# (OLLAMA_URL=http://ollama:11434) или другой хост/порт.
# OLLAMA_URL=
# У Ollama нет каталога бесплатных моделей для перебора -- OLLAMA_MODEL
# обязателен, иначе complete_json() сразу возвращает None.
# OLLAMA_MODEL=llama3.1

# --- фоновая AI-разметка каналов и видео (этап 03) ---------------------------
# Работает только если LLM_PROVIDER != none (см. выше) -- иначе шаг "enrich"
# в воркере просто пропускается, без обращений к БД сверх обычного.
WORKER_ENRICH_INTERVAL_MIN=120
WORKER_ENRICH_CHANNEL_BATCH=50
WORKER_ENRICH_VIDEO_BATCH=100
# Канал переразмечается, если метка старше стольки дней (или её вообще нет).
LLM_RELABEL_DAYS=30
# Ниша начинает авто-теговаться LLM только когда в конкретной tag_group уже
# накопилось столько ручных/claude-mcp тегов -- иначе таксономия не устоялась.
LLM_MIN_MANUAL_TAGS=20
# Cache lifetime for comment_insights and explain_outlier (why-viral) results;
# a repeat call inside the window costs neither quota nor LLM budget.
LLM_INSIGHTS_TTL_DAYS=7
LLM_WHY_VIRAL_TTL_DAYS=14

# --- niche clusters (stage 08) ----------------------------------------------
# k-means over channel embeddings, recomputed by the worker on this interval.
# Needs at least NICHE_CLUSTERS_MIN_CHANNELS channels with embedded videos;
# channels above NICHE_CLUSTERS_COMPETITION_SUBS count as competition.
WORKER_CLUSTER_INTERVAL_MIN=1440
NICHE_CLUSTERS_MIN_CHANNELS=10
NICHE_CLUSTERS_COMPETITION_SUBS=100000

# Maturity curve (share of 30-day views a video has at age N days), used by
# every age-adjusted score and projected30dViews. The worker re-fits it from
# your own snapshots on this interval and switches over only once 30+ videos
# have been watched from publication to 28+ days. MATURITY_CURVE_AUTO=0 keeps
# the shipped curve.
WORKER_CALIBRATE_INTERVAL_MIN=1440
MATURITY_CURVE_AUTO=1

# --- доставка алертов в Telegram / webhook (этап 07) -------------------------
# Выключено по умолчанию -- воркер только пишет события в events, никуда их
# не шлёт, пока не задан хотя бы один канал ниже. Telegram имеет приоритет
# над webhook, если заданы оба. НЕ коммитьте настоящий токен бота в git.
# NOTIFY_TELEGRAM_BOT_TOKEN=
# NOTIFY_TELEGRAM_CHAT_ID=
# NOTIFY_WEBHOOK_URL=
# Проверить: python cli.py notify-test (или docker compose exec web python cli.py notify-test)
NOTIFY_MAX_PER_CYCLE=10
# Ссылка "дашборд" в сообщениях -- поменяйте, если дашборд не на localhost.
NOTIFY_DASHBOARD_URL=http://127.0.0.1:8080
